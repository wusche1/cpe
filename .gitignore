__pycache__/
*.pyc
.venv
.vscode/tasks.json
.cursor/rules/style.mdc
.DS_Store
wandb/
tmp/
*.bin
*.safetensors
*.pth
#tmp/
*.egg-info/
dist/
build/



**/nohup.out


.env

# same policy one level deeper, for experiments/<group>/<sub>/results/
experiments/*/*/results/**/adapter/
experiments/*/*/results/**/adapters/
experiments/*/*/results/**/completions.json
experiments/*/*/results/**/logs.txt
experiments/*/*/results/**/logs.txt.sync
.env.remote

# Results: commit the summary stats (config.yaml, test_results*.json, selection.json,
# judged_ranking*.json, training/training_meta.json); ignore the data-heavy artifacts
# and any debug/failed runs.
**/results/*debug*/
experiments/*/results/**/adapters/
experiments/*/results/**/completions.json
# sharded harvest output: completions_0_256.json, completions_256_512.json
experiments/*/results/**/completions_*.json
experiments/*/results/**/training/factors/
# per-factor judge verdict cache: regenerable, one JSON blob per factor
experiments/*/results/judge_cache/
# trained factor set shipped to the remote as a tar
experiments/*/factors_*.tar
experiments/*/results/**/*.safetensors
experiments/*/results/**/*.pt
experiments/*/results/**/*.pth
experiments/*/results/**/logs.txt
experiments/*/results/**/logs.txt.sync
